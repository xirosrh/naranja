text Naranja_Tangelo_G24_M29_Text_081955B0 {
    "{COLOR 0x06}Hiii hiii\p{COLOR 0x04}{PLAYER}: ¡Pobre lapras!\nLe han atacado, pero sus heridas\lya han mejorado mejor.\pNecesita ayuda de un experto.\n¿No crees Tacey?\p{COLOR 0x03}Tracey: Quizás sì.\pLo mejor será llevarlo al centro pokemon.\n¡Vamos!"
}

text Naranja_Tangelo_G24_M29_Text_081B7B68 {
    "{COLOR 0x03}Tracey: ¿Conoces al Prf. OAK?\n¡¡ Demuéstramelo !!"
}

text Naranja_Tangelo_G24_M29_Text_081B7B9D {
    "{COLOR 0x0D}¡Te llevas de maravilla\ncon tus pokemon !"
}

text Naranja_Tangelo_G24_M29_Text_081B7BD0 {
    "{COLOR 0x03}Este Lapras te ayudará a moverte \npor el mar."
}

text Naranja_Tangelo_G24_M29_Text_086B5340 {
    "No sé porque estára\neste wailmer en el centro\pDesde luego no parece\nque sea por depresión."
