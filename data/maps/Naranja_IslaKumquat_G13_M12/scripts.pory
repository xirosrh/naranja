text Naranja_IslaKumquat_G13_M12_Text_0818B622 {
    "Uh...\nOh, yes, I’m the MOVE DELETER.\pI can make POKéMON forget their moves.\pWould you like me to do that?"
}

text Naranja_IslaKumquat_G13_M12_Text_0818B68C {
    "Which POKéMON should forget a move?"
}

text Naranja_IslaKumquat_G13_M12_Text_0818B6B0 {
    "Which move should be forgotten?"
}

text Naranja_IslaKumquat_G13_M12_Text_0818B6D0 {
    "{STR_VAR_1} seems to know only one\nmove..."
}

text Naranja_IslaKumquat_G13_M12_Text_0818B6F2 {
    "Hm! {STR_VAR_1}’s {STR_VAR_2}?\nThat move should be forgotten?"
}

text Naranja_IslaKumquat_G13_M12_Text_0818B71E {
    "It worked to perfection!\p{STR_VAR_1} has forgotten\n{STR_VAR_2} completely."
}

text Naranja_IslaKumquat_G13_M12_Text_0818B757 {
    "Come again if there are other moves\nto be forgotten."
}

text Naranja_IslaKumquat_G13_M12_Text_0818B78C {
    "What?\nNo EGG should know any moves."
}
