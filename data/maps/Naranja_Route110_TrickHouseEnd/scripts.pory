script Naranja_Route110_TrickHouseEnd_EventScript_Trigger_1 {
    lockall
    turnobject(LOCALID_NARANJA_ROUTE110_TRICK_HOUSE_END_MAN_1_1, 3)
    playse(SE_PIN)
    applymovement(LOCALID_NARANJA_ROUTE110_TRICK_HOUSE_END_MAN_1_1, Naranja_MeteorFalls_1F_1R_Movement_081A0833)
    waitmovement(LOCALID_NONE)
