    msgbox(Naranja_Route110_TrickHouseEnd_Text_0819CA8B, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Naranja_Route110_TrickHouseEnd_Movement_08161CE8)
    waitmovement(LOCALID_NONE)
    delay(4)
    turnobject(LOCALID_NARANJA_ROUTE110_TRICK_HOUSE_END_MAN_1_1, 4)
    releaseall
