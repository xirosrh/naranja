text Naranja_Route110_TrickHousePuzzle8_Text_0819E178 {
    "Not many TRAINERS have made it\nthis far."
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E1A1 {
    "That must mean you’re tough, too..."
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E1C5 {
    "You’ve beaten the POKéMON LEAGUE\nCHAMPION? That’s too much!"
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E201 {
    "Consider yourself lucky to be\nbattling me!"
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E22C {
    "This isn’t right!\nI can’t lose!"
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E24C {
    "It’s a miracle that you beat me.\nYou can brag about it."
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E284 {
    "You’ve been slugging through the TRICK\nHOUSE challenge, too."
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E2C1 {
    "I see...\nYou possess an extraordinary style."
}

text Naranja_Route110_TrickHousePuzzle8_Text_0819E2EE {
    "Seeing someone like you should please\nthe TRICK MASTER."
}
