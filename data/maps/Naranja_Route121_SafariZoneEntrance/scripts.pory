text Naranja_Route121_SafariZoneEntrance_Text_081C35D0 {
    "Welcome to the SAFARI ZONE!\pHere, you may witness many kinds of\nPOKéMON rarely seen in HOENN.\pAnd, you’ll see them in their wild,\nuntamed state in natural habitats.\pWhat’s more, we’ve thrown open the\ngates to POKéMON TRAINERS.\pYou’re encouraged to catch POKéMON\nfor keeps!\pCome in and enjoy the SAFARI ZONE!"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C3704 {
    "Welcome to the SAFARI ZONE!\nIs it your first time here?"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C373C {
    "Come in and enjoy the SAFARI ZONE!"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C375F {
    "When you enter the SAFARI ZONE, you\nstart with 30 SAFARI BALLS for\lcatching POKéMON.\pThe SAFARI Game is over when you run\nout of SAFARI BALLS, or when you’ve\lwalked 500 steps.\pCome in and enjoy the SAFARI ZONE!"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C3832 {
    "Welcome to the SAFARI ZONE!\pAll you can catch for just ¥500!\nWould you like to play a SAFARI Game?"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C3895 {
    "Okay.\nPlease play another time!"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C38B5 {
    "You don’t have enough money.\nSorry."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C38D9 {
    "That will be ¥500, please."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C38F4 {
    "Here are your SAFARI BALLS."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C3910 {
    "{PLAYER} received 30 SAFARI BALLS."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C392D {
    "We’ll let you know when your game\nis over.\pSo, until then, enjoy yourself, please!\nOff you go on your wild excursion!"
}

text Naranja_Route121_SafariZoneEntrance_Text_081C39A3 {
    "Excuse me!\nYour PC BOX is full."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C39C3 {
    "Excuse me!\nYou seem to be without a オカキクケ CASE.\pYour SAFARI Game will be much more\nfruitful if you use オカキクケS.\pPlease come back with a オカキクケ CASE."
}

text Naranja_Route121_SafariZoneEntrance_Text_081C3E4B {
    "SAFARI ZONE TRAINER TIP!\pThrow オカキクケS at wild POKéMON to make\nthem less likely to flee."
}
