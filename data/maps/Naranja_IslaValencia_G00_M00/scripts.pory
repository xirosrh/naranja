text Naranja_IslaValencia_G00_M00_Text_08164490 {
    "Me aburro mucho, así que me dedico\na pasear sin salir de estos cuadrados.\pPuede parecer estùpido,\npero es más original que ser otro\lentrenador de pokemon más.\p{COLOR 0x04}{PLAYER}: ¿¿??"
}

text Naranja_IslaValencia_G00_M00_Text_08164602 {
    "{COLOR 0x0D}Isla VALENCIA\n{SHIFT_DOWN 0x00}“Paraiso sureño”"
}

text Naranja_IslaValencia_G00_M00_Text_0816D361 {
    "WALLY: {PLAYER}...\nPOKéMON hide in tall grass like this,\ldon’t they?\pPlease watch me and see if I can\ncatch one properly.\p...Whoa!"
}

text Naranja_IslaValencia_G00_M00_Text_0816D3DE {
    "WALLY: I did it... It’s my...\nMy POKéMON!"
}

text Naranja_IslaValencia_G00_M00_Text_0816D408 {
    "{PLAYER}, thank you!\nLet’s go back to the GYM!"
}

text Naranja_IslaValencia_G00_M00_Text_086B5DF0 {
    "Humm…\pMejor no alejarse demasiado\pAhora tengo que ver\ncomo volveré a P. Paleta."
}
