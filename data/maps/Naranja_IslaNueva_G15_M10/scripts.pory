text Naranja_IslaNueva_G15_M10_Text_0818FEA1 {
    "Hello! You’re our first guest in a\ngood while.\pYou’ve brightened up my day, so I’ll\ngive you a big WAILMER DOLL."
}

text Naranja_IslaNueva_G15_M10_Text_0818FF12 {
