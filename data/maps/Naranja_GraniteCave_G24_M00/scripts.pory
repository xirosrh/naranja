text Naranja_GraniteCave_G24_M00_Text_0816CA83 {
    "{COLOR 0x0D}Isla NAVEL \n{COLOR 0x09}“Con tanto frìo no tenemos ni lema”"
}

text Naranja_GraniteCave_G24_M00_Text_08193237 {
    "Hehehe!\pWith this METEORITE, MT. CHIMNEY\nwill..."
}

text Naranja_GraniteCave_G24_M00_Text_08193268 {
    "Heh?\pI don’t know who you are, but if you get\nin the way of TEAM {AQUA}, don’t\lexpect any mercy!"
}

text Naranja_GraniteCave_G24_M00_Text_081932C5 {
    "Hold it right there, TEAM {AQUA}!\pWe, TEAM {MAGMA}, won’t allow you to\nget away with your misdeeds!"
}

text Naranja_GraniteCave_G24_M00_Text_08193320 {
    "Hehehe!\nEven TEAM {MAGMA} joins us!\pBut it’s too much trouble to deal with\nyou all...\pHeh, it doesn’t matter!\pWe’ve got the METEORITE, so off to\nMT. CHIMNEY we go!\pHehehe! Be seeing you, you TEAM\n{MAGMA} dingbats!"
}

text Naranja_GraniteCave_G24_M00_Text_08193584 {
    "Who might you be?\p... ... ... ... ... ... ... ...\n... ... ... ... ... ... ... ...\pAh, so you are {PLAYER}{KUN}.\pI am ARCHIE. As the head of TEAM AQUA,\nI have dedicated myself to thwarting\lthe dangerous plans of TEAM MAGMA.\pWhy? Because TEAM MAGMA is a grave\nthreat to us all.\pThey have committed many destructive\nacts in their bid to expand the land.\pWe, TEAM AQUA, love the sea above\nall! TEAM MAGMA is our sworn enemy!"
}

text Naranja_GraniteCave_G24_M00_Text_08193720 {
    "{MAXIE}, we should give chase to\nTEAM {AQUA}..."
}

text Naranja_GraniteCave_G24_M00_Text_08193747 {
    "{MAXIE}: Yes, yes, we must!\nWe’ve got to hurry.\pThere’s no telling what TEAM {AQUA}\nwill do at MT. CHIMNEY!"
}

text Naranja_GraniteCave_G24_M00_Text_081937AA {
    "{MAXIE}: {PLAYER}{KUN}, you should keep\nan eye out for TEAM {AQUA}, too.\pFarewell!"
}

text Naranja_GraniteCave_G24_M00_Text_081937EB {
    "I... I’m COZMO...\nI’m a PROFESSOR...\pI usually study METEORITES in\nFALLARBOR TOWN...\pThen some people from TEAM {AQUA}\nmade me guide them to METEOR FALLS...\pThey promised me that they would\nexcavate METEORITES for me...\pBut, I...\nTEAM {AQUA} tricked me...\pOh... That METEORITE...\nIt will never be mine now...\pBut that TEAM {AQUA}...\pWhat are they going to do with that\nMETEORITE at MT. CHIMNEY?"
}

text Naranja_GraniteCave_G24_M00_Text_0819396A {
    "PROF. COZMO: That TEAM {AQUA}...\pWhat are they going to do with that\nMETEORITE at MT. CHIMNEY?"
}
