text Naranja_ColdPath_FossilManiacsTunnel_Text_0816EF65 {
    "Number of collisions:\n... ... {STR_VAR_1}!\pTotal time:\n... ... {STR_VAR_2}!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0816EF9F {
    "Bravo! Splendid showing!\pYour love of cycling comes from deep\nwithin your heart.\lYou’ve shaken me to my very soul!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0816F012 {
    "Your technique is remarkable.\pI suggest you slow down just enough\nto avoid collisions."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0816F069 {
    "I would consider you a work in\nprogress.\pStill, I hope you don’t forget the\nsheer pleasure of cycling."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0816F0D0 {
    "My word... Your cycling skills border\non terrifying.\pMost certainly, you need much more\npractice riding."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0816F139 {
    "...I am aghast...\pYou’re perhaps not cut out for this\nunfortunate cycling business.\pYou ought to give serious thought to\nreturning that BIKE to RYDEL."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_0819E3AD {
    "Sorry, you can’t walk on CYCLING\nROAD. It’s too dangerous.\pPlease come back with a BIKE."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7B61 {
    "¡No te acerques al borde\no te despeñarás!\p¡Para competir móntate\nen el TRINEO que hiciste!\l¡La opción está en tu mochila!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7BDB {
    "¡No diré más {PLAYER}!\pGracias a tus POKéMON \nme ganaste tallando el TRINEO.\pAhora echemos una carrera\nbajando la pendiente\lmontandos en trineo  hasta la orilla.\p¡Como pierdas\ntendrás que repetir las pruebas!\pPreparados.\pListos.\p¡Ya!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7CBF {
    "Danny: ¡Colócate en tu posición!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7D9B {
    "¡Comienza la carrera!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7EA0 {
    "¡Guau! ¿Ya estás aquì!\p¡Es fìsicamente imposible!\n¡Sube a repetirlo!"
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7EE5 {
    "¡Muy bien hecho {PLAYER}!\pVamos a mi gimnasio\nque te mereces un combate."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7F28 {
    "¡Vaya!\n¡Te quedaste a un chispitìn!\pTe aconsejo que sin ir lento\naminores lo justo para no ir\lchocándote con los muros."
}

text Naranja_ColdPath_FossilManiacsTunnel_Text_086B7FA0 {
    "¡Te gané con ventaja, {PLAYER}!\pSi vas a lo loco irás chocándote\ny te equivocarás de camino.\p¡Sangre frìa!"
}
