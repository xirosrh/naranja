text Naranja_ShamoutiIsland_House1_Text_0818568C {
    "Hi, there’s this POKéMON that I’m\nlooking for.\pI want a {STR_VAR_1}.\nDo you have one?\pWould you trade it for my {STR_VAR_2}?"
}

text Naranja_ShamoutiIsland_House1_Text_081856F7 {
    "Thank you!\pI’ll be good to your {STR_VAR_1},\nso please be nice to my {STR_VAR_2}!"
}

text Naranja_ShamoutiIsland_House1_Text_08185737 {
    "Wait!\nThat POKéMON isn’t a {STR_VAR_1}.\pI guess you don’t want to trade\nwith me."
}

text Naranja_ShamoutiIsland_House1_Text_0818577F {
    "Oh, okay. If you change your mind,\nplease come see me.\pI’ll be waiting!"
}

text Naranja_ShamoutiIsland_House1_Text_081857C7 {
    "Thank you for trading with me!\pI really wanted this POKéMON, so\nI promise to take good care of it!"
}

text Naranja_ShamoutiIsland_House1_Text_0818582A {
    "Trading POKéMON with others...\pIt’s as if you’re trading your own\nmemories with other people."
}

text Naranja_ShamoutiIsland_House1_Text_08185888 {
