script Naranja_ShamoutiIsland_House1_EventScript_Woman1 {
    lock
    faceplayer
    checkflag(FLAG_NARANJA_SHAMOUTI_ISLAND_EVENT_COMPLETE_009B)
    goto_if(EQUAL, Naranja_ShamoutiIsland_House1_EventScript_Sub_08157EAD)
    setvar(VAR_0x8008, 1)
    copyvar(VAR_0x8004, VAR_0x8008)
    specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
    copyvar(VAR_0x8009, VAR_RESULT)
    msgbox(Naranja_ShamoutiIsland_House1_Text_0818568C, MSGBOX_YESNO)
    compare_var_to_value(VAR_RESULT, 0)
    goto_if(EQUAL, Naranja_ShamoutiIsland_House1_EventScript_Sub_08157E95)
    special(ChoosePartyMon)
    waitstate
    copyvar(VAR_0x800A, VAR_0x8004)
    compare_var_to_value(VAR_0x8004, 0xFF)
    goto_if(EQUAL, Naranja_ShamoutiIsland_House1_EventScript_Sub_08157E95)
    copyvar(VAR_0x8005, VAR_0x800A)
    specialvar(VAR_RESULT, GetTradeSpecies)
    copyvar(VAR_0x800B, VAR_RESULT)
    compare_var_to_var(VAR_RESULT, VAR_0x8009)
    goto_if(NOT_EQUAL, Naranja_ShamoutiIsland_House1_EventScript_Sub_08157E9F)
    copyvar(VAR_0x8004, VAR_0x8008)
    copyvar(VAR_0x8005, VAR_0x800A)
    special(CreateInGameTradePokemon)
    special(DoInGameTradeScene)
    waitstate
    bufferspeciesname(0, 0x8009)
    msgbox(Naranja_ShamoutiIsland_House1_Text_081856F7, MSGBOX_DEFAULT)
    setflag(FLAG_NARANJA_SHAMOUTI_ISLAND_EVENT_COMPLETE_009B)
    release
    end
}

