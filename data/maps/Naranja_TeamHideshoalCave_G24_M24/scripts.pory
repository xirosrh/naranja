text Naranja_TeamHideshoalCave_G24_M24_Text_08196E6F {
    "If you want to know the secret about\nour HIDEOUT, you have me to beat!"
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196EB6 {
    "I can’t win at all..."
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196ECC {
    "Our HIDEOUT’s secret?\pWell, let’s just say...\nThere’s a submarine at the far end!\pBut, by now...\nKekekeke..."
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196F39 {
    "Fuel supply loaded A-OK!\nIn-cruise snacks loaded A-OK!\pNothing left to do but KO a pesky\nmeddler!"
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196F9B {
    "I took a serious licking!"
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196FB5 {
    "Humph!\nThis was supposed to happen!\pMy mission was to just hold you up!"
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08196FFD {
    "Yawn... Keeping watch over the\nHIDEOUT bores me. I’ll take you on."
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08197040 {
    "Yawn...\nOh, I lost..."
}

text Naranja_TeamHideshoalCave_G24_M24_Text_08197056 {
    "If you scurry too much, other TEAM\n{AQUA} members might get you."
}
