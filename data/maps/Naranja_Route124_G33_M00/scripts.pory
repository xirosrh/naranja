text Naranja_Route124_G33_M00_Text_0819F416 {
    "I’m the DIVING TREASURE HUNTER!\pI’m the awesome dude who makes\ndeep-sea dives to gather treasures\lresting at the bottom."
}

text Naranja_Route124_G33_M00_Text_0819F48F {
    "Tell me, have you seen any SHARDS of\ntools made in ancient times?"
}

text Naranja_Route124_G33_M00_Text_0819F4D1 {
    "You haven’t got any treasures\nfor me...\pIf you see any SHARDS, like the RED\nSHARD, you’ve got to trade it with me!"
}

text Naranja_Route124_G33_M00_Text_0819F544 {
    "Oh, hey! That...\nThat’s a SHARD! I’m looking for those!\pOh, man, you’ve got to trade that\nwith me! I’ll give you something good!"
}

text Naranja_Route124_G33_M00_Text_0819F5C5 {
    "What do you want to trade?"
}

text Naranja_Route124_G33_M00_Text_0819F5E0 {
    "You’ll trade your {STR_VAR_1} for\nmy {STR_VAR_2}, then?"
}

text Naranja_Route124_G33_M00_Text_0819F606 {
    "It’s a done deal!\nUse that wisely!"
}

text Naranja_Route124_G33_M00_Text_0819F629 {
    "Do you want to trade something else?"
}

text Naranja_Route124_G33_M00_Text_0819F64E {
    "Whoops, your BAG’s full.\nGet rid of some items, friend!"
}

text Naranja_Route124_G33_M00_Text_0819F686 {
    "No? That’s a downer.\nWell, if you change your mind, come back."
}

text Naranja_Route124_G33_M00_Text_0819F6C5 {
    "Wanted item              Trade item\n RED SHARD           ロワ FIRE STONE\pWanted item              Trade item\n YELLOW SHARD     ロワ THUNDERSTONE\pWanted item              Trade item\n BLUE SHARD         ロワ WATER STONE\pWanted item              Trade item\n GREEN SHARD       ロワ LEAF STONE"
}
