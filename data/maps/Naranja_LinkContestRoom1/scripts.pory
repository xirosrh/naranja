text Naranja_LinkContestRoom1_Text_081A68F0 {
    "MC: Hello! We’re just getting started\nwith a {STR_VAR_3} Rank POKéMON\l{STR_VAR_2} CONTEST!\pThe participating TRAINERS and their\nPOKéMON are as follows:"
}

text Naranja_LinkContestRoom1_Text_081A6976 {
    "MC: Hello! We’re just getting started\nwith a 4-player linked POKéMON\l{STR_VAR_2} CONTEST!\pThe participating TRAINERS and their\nPOKéMON are as follows:"
}

text Naranja_LinkContestRoom1_Text_081A6A04 {
    "MC: Entry No. {STR_VAR_2}!\n{STR_VAR_1}’s {STR_VAR_3}!"
}

text Naranja_LinkContestRoom1_Text_081A6A1F {
    "MC: We’ve just seen the four POKéMON\ncontestants.\pNow it’s time for primary judging!\pThe audience will vote on their\nfavorite POKéMON contestants.\pWithout any further ado, let the\nvoting begin!"
}

text Naranja_LinkContestRoom1_Text_081A6AE1 {
    "Voting under way..."
}

text Naranja_LinkContestRoom1_Text_081A6AF5 {
    "Voting is now complete!\pWhile the votes are being tallied,\nlet’s move on to secondary judging!\pThe second stage of judging is the\nmuch anticipated appeal time!\pMay the contestants amaze us with\nsuperb appeals of dazzling moves!\pLet’s see a little enthusiasm!\nLet’s appeal!"
}

text Naranja_LinkContestRoom1_Text_081A6C06 {
    "MC: That’s it for judging!"
}

text Naranja_LinkContestRoom1_Text_081A6C21 {
    "Thank you all for a most wonderful\ndisplay of quality appeals!\pThis concludes all judging!\nThank you for your fine efforts!"
}

text Naranja_LinkContestRoom1_Text_081A6C9D {
    "Now, all that remains is the pulse-\npounding proclamation of the winner.\pThe JUDGE looks ready to make the\nannouncement!"
}

text Naranja_LinkContestRoom1_Text_081A6D16 {
    "JUDGE: I will now declare the winner!"
}

text Naranja_LinkContestRoom1_Text_081A6D3C {
    "MC: Entry No. {STR_VAR_2}!\p{STR_VAR_3} and {STR_VAR_1},\ncongratulations!"
}

text Naranja_LinkContestRoom1_Text_081A6D6A {
    "We confer on you this RIBBON as your\nprize!"
}

text Naranja_LinkContestRoom1_Text_081A6D96 {
    "{PLAYER} received a RIBBON."
}

text Naranja_LinkContestRoom1_Text_081A6DAC {
    "{PLAYER} put the RIBBON on\n{STR_VAR_1}."
}

text Naranja_LinkContestRoom1_Text_081A6DC5 {
    "MC: Here you are!\nPlease accept your prize!"
}

text Naranja_LinkContestRoom1_Text_081A6DF1 {
    "MC: Congratulations!\nPlease do compete again!"
}

text Naranja_LinkContestRoom1_Text_081A6E1F {
    "Please pick up your prize at the\nreception counter later.\lPlease do compete again!"
}
