text Naranja_IslaMurcott_G09_M04_Text_0817D46A {
    "Hi, hi! I’m the NAME RATER!\nI’m the fortune-teller of names!\pI shall be pleased to rate your\nPOKéMON’s nickname."
}

text Naranja_IslaMurcott_G09_M04_Text_0817D4DB {
    "Which POKéMON’s nickname should\nI divine?"
}

text Naranja_IslaMurcott_G09_M04_Text_0817D505 {
    "Hmmm... {STR_VAR_1}, is it? That is\nquite a fine name you bestowed.\pBut! What say you, if I were to\nsuggest a slightly better name?"
}

text Naranja_IslaMurcott_G09_M04_Text_0817D580 {
    "Ah, good. Then, what shall the new\nnickname be?"
}

text Naranja_IslaMurcott_G09_M04_Text_0817D5B0 {
    "Done! From now on, this POKéMON\nshall be known as {STR_VAR_1}!\pIt is a better name than before!\nHow fortunate for you!"
}

text Naranja_IslaMurcott_G09_M04_Text_0817D61E {
    "I see.\nDo come visit again."
}

text Naranja_IslaMurcott_G09_M04_Text_0817D63A {
    "Done! From now on, this POKéMON\nshall be known as {STR_VAR_1}!\pIt looks no different from before,\nand yet, this is vastly superior!\lHow fortunate for you!"
}

text Naranja_IslaMurcott_G09_M04_Text_0817D6CC {
    "Hmmm... {STR_VAR_1} it is!\pThis is a magnificent nickname!\nIt is impeccably beyond reproach!\pYou’ll do well to cherish your\n{STR_VAR_1} now and beyond."
}

text Naranja_IslaMurcott_G09_M04_Text_0817D752 {
    "Now, now.\nThat is merely an EGG!"
}
