text Naranja_Valledelasflores_G24_M11_Text_0819542B {
    "Jueves: Unos villanos me robaron\nmi SuperBall.\pPor cierto, ¿Te gusta mi nombre?\nMe lo puso mi padre no sé por que."
}

text Naranja_Valledelasflores_G24_M11_Text_0819549E {
    "Oh, neat!\nThat’s the BADGE from RUSTBORO GYM!\pYou must be a TRAINER.\nYou should try using this item."
}

text Naranja_Valledelasflores_G24_M11_Text_08195503 {
    "It’s a MIRACLE SEED.\nIf a POKéMON holds that item, its\lGRASS-type moves become stronger.\pBesides MIRACLE SEED, I think there are\nother convenient items for POKéMON\lto hold."
}

text Naranja_Valledelasflores_G24_M11_Text_081956A6 {
    "Vileplume: {COLOR 0x02}Vaaaaa\p{COLOR 0x04}¡Preparate para pelear Vileplume!\p{COLOR 0x01}Puuff"
}

text Naranja_Valledelasflores_G24_M11_Text_081956E9 {
    "{COLOR 0x04}Humm… ¡que bien huele!\nEstá echando su aroma.\p…\p¡Oh no! ¡¡Son esporas!!\p…\p¡ Que sueño…\pZzz\p{COLOR 0x01}Vileplume: {COLOR 0x02}Vaaiiil"
}

text Naranja_Valledelasflores_G24_M11_Text_081BD0AF {
    "Jaja…\nMis bichos son fuertes.\l¡ Lucha !"
}

text Naranja_Valledelasflores_G24_M11_Text_081BD0D7 {
    "¡Vaya!\nMis pequeños insectos"
}

text Naranja_Valledelasflores_G24_M11_Text_081BD0F4 {
    "Los bichos crecen rápidamente.\nY a mí no me sobra el tiempo."
}

text Naranja_Valledelasflores_G24_M11_Text_086B5223 {
    "Vileplume: {COLOR 0x02}¡Vahh! Vaaaa…\p{COLOR 0x04}¡Prepárate para luchar Vileplume!\p{COLOR 0x01}Vileplume: {COLOR 0x02}¿Vahh…\p{COLOR 0x04}…pero esta vez ya estoy preparado.\n¡Tengo protección antiesporas!\pVeamos esta vez   \nquien sale de aquì dormido."
}
