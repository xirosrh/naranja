text Naranja_IslaNavel_G05_M05_Text_08177755 {
    "PROF. COZMO: Oh...\nI never should have let myself be\lconned into telling TEAM {AQUA} where\lyou can find METEORITES...\pThat METEORITE from METEOR FALLS...\nIt’s never going to be mine now..."
}

text Naranja_IslaNavel_G05_M05_Text_0817780E {
    "Oh!\nHah?\pThat item...\pCould it be?\pIs it the METEORITE that TEAM {AQUA}\ntook from METEOR FALLS?\pPlease, may I have it?\pI’m not asking for it for free.\nHow about in exchange for this TM?"
}

text Naranja_IslaNavel_G05_M05_Text_081778C4 {
    "PROF. COZMO: This TM, it represents\nmy feeling of gratitude.\lPlease use it!"
}

text Naranja_IslaNavel_G05_M05_Text_08177910 {
    "PROF. COZMO: Oh, I can’t believe it.\nThis is really, really great!\pThis is really going to help my research!"
}

text Naranja_IslaNavel_G05_M05_Text_0817797D {
    "PROF. COZMO: Oh, but...\nI’m crushed with disappointment..."
}

text Naranja_IslaNavel_G05_M05_Text_081779B8 {
    "PROF. COZMO: Please, may I have that\nMETEORITE?\pI’m not asking for it for free.\nHow about in exchange for this TM?"
}

text Naranja_IslaNavel_G05_M05_Text_08177A2B {
    "PROF. COZMO went off to METEOR FALLS\non ROUTE 114 with some people from\lTEAM {AQUA}."
}

text Naranja_IslaNavel_G05_M05_Text_08177A7C {
    "Poor PROF. COZMO...\nHe’s so depressed... I feel sorry for him."
}

text Naranja_IslaNavel_G05_M05_Text_08177ABB {
    "Look at PROF. COZMO...\nHe’s so happy! I think it’s cute."
}
