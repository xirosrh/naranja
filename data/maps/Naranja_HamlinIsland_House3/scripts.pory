text Naranja_HamlinIsland_House3_Text_0817940E {
    "Hello, TRAINER. Would you do me a favor\nand trade POKéMON with me?\pLiving in PACIFIDLOG, I can only catch\ncertain kinds of POKéMON.\p{STR_VAR_1}? Do you have one?\nI’ll trade you my {STR_VAR_2} for it."
}

text Naranja_HamlinIsland_House3_Text_081794C4 {
    "Wow!\nThis {STR_VAR_1} is so fluffy!"
}

text Naranja_HamlinIsland_House3_Text_081794DF {
    "That’s no {STR_VAR_1}."
}

text Naranja_HamlinIsland_House3_Text_081794ED {
    "I’m a little disappointed..."
}

text Naranja_HamlinIsland_House3_Text_0817950A {
    "Since we traded, you and me,\nwe’re friends, aren’t we?"
}

text Naranja_HamlinIsland_House3_Text_08179541 {
    "Is that a POKéDEX?\pDid you get to meet a lot of different\nPOKéMON?\pI wish I was like you."
}
