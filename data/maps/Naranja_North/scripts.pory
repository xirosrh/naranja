script Naranja_North_EventScript_Nurse {
    faceplayer
    checkitem(ITEM_POTION, 0)
    compare_var_to_value(VAR_RESULT, 0)
    goto_if(EQUAL, Naranja_North_EventScript_Sub_086B7266)
    nop
    removeitem(ITEM_POTION, 1)
    msgbox(Naranja_North_Text_086B76F5, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_NORTH_NURSE, Naranja_North_Movement_081586D5)
    delay(5)
    nop
    msgbox(Naranja_North_Text_086B7757, MSGBOX_AUTOCLOSE)
    playfanfare(MUS_HEAL)
    delay(0x50)
    applymovement(LOCALID_NARANJA_NORTH_AZURILL, Naranja_North_Movement_086B727C)
    delay(0x30)
    nop
    faceplayer
    setflag(FLAG_HIDE_NARANJA_NAVEL_ISLAND_G05_M03_WOMAN_3)
    clearflag(FLAG_HIDE_NARANJA_COLD_PATH_G20_M02_NURSE)
    nop
    nop
    call(Naranja_NavelIsland_PokemonCenter_1F_EventScript_Woman3)
    end
}

script Naranja_North_EventScript_Sub_086B7266 {
    msgbox(Naranja_North_Text_086B76B3, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_NORTH_NURSE, Naranja_North_Movement_081586D5)
    delay(0x10)
    release
    end
}

