text Naranja_IslaMellsweet_G14_M07_Text_0818DA77 {
    "STEVEN: {PLAYER}{KUN}?\pYes, this is my place. It’s a little\nembarrassing how empty it is here.\pOh, here, you should take this HM.\pIt contains DIVE.\nI’ve already taught my POKéMON."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DB22 {
    "STEVEN: While you’re using SURF, you\nshould notice dark patches of water.\pUse DIVE if you come to deep water\nlike it. You’ll drop to the seafloor.\pWhen you want to come back up, use\nDIVE again.\pIn some places, it won’t be possible\nfor you to surface, though."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DC25 {
    "STEVEN: Apparently, there’s an\nunderwater cavern between\lMOSSDEEP and SOOTOPOLIS.\pYou know, the one that CAPT. STERN\nfound in his submarine.\pAn underwater cavern...\pThere might be some rare stones down\nthere... I should go for a DIVE..."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DD12 {
    "{PLAYER} checked the POKé BALL.\pIt contained the POKéMON\nBELDUM.\pTake the POKé BALL?"
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DD61 {
    "{PLAYER} obtained a BELDUM."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DD77 {
    "There is no space for another POKéMON."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DD9E {
    "{PLAYER} left the POKé BALL where\nit was."
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DDC2 {
    "It’s a letter.\p... ... ... ... ... ...\pTo {PLAYER}{KUN}...\pI’ve decided to do a little soul-\nsearching and train on the road.\pI don’t plan to return home for some\ntime.\pI have a favor to ask of you.\pI want you to take the POKé BALL on\nthe desk.\pInside it is a BELDUM, my favorite\nPOKéMON.\pI’m counting on you.\pMay our paths cross some day.\pSTEVEN STONE"
}

text Naranja_IslaMellsweet_G14_M07_Text_0818DF1A {
    "It’s a letter.\p... ... ... ... ... ...\pTo {PLAYER}{KUN}...\pI’ve decided to do a little soul-\nsearching and train on the road.\pI don’t plan to return home for some\ntime.\pI have a favor to ask of you.\pI want you to take the POKé BALL on\nthe desk.\pInside it is a BELDUM, my favorite\nPOKéMON.\pI’m counting on you.\pIf you’d like, you should also take\nthe HM DIVE.\pMay our paths cross some day.\pSTEVEN STONE"
}

text Naranja_IslaMellsweet_G14_M07_Text_0818E0A3 {
    "It’s a collection of rare rocks and\nstones assembled by STEVEN."
}

text Naranja_IslaMellsweet_G14_M07_Text_081A1102 {
    "Want to give a nickname to the\n{STR_VAR_2} you received?"
}
