text Naranja_7islasPomelo_G03_M02_Text_081A13DF {
    "I’m terribly sorry. The COLOSSEUM\nis undergoing adjustments."
}

text Naranja_7islasPomelo_G03_M02_Text_081A141C {
    "I’m terribly sorry. The TRADE CENTER\nis undergoing inspections."
}

text Naranja_7islasPomelo_G03_M02_Text_081A145C {
    "I’m terribly sorry. The RECORD CORNER\nis under preparation."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4510 {
    "Welcome to the POKéMON CABLE CLUB\nCOLOSSEUM.\pYou may battle with your friends here.\pWould you like to battle?"
}

text Naranja_7islasPomelo_G03_M02_Text_081A457E {
    "Welcome to the POKéMON CABLE CLUB\nTRADE CENTER.\pYou may trade your POKéMON here\nwith a friend.\pWould you like to trade POKéMON?"
}

text Naranja_7islasPomelo_G03_M02_Text_081A45FE {
    "Welcome to the POKéMON CABLE CLUB\nRECORD CENTER.\pYou may mix your records as a TRAINER\nwith the records of your friends.\pWould you like to mix records?"
}

text Naranja_7islasPomelo_G03_M02_Text_081A4696 {
    "There are three link battle modes.\pSINGLE BATTLE is for two TRAINERS\nwith one or more POKéMON each.\pEach TRAINER can have one POKéMON\nin battle at a time.\pDOUBLE BATTLE is for two TRAINERS\nwith two or more POKéMON each.\pEach TRAINER will send out two\nPOKéMON in battle at a time.\pMULTI BATTLE is for four TRAINERS\nwith one or more POKéMON each.\pEach TRAINER can have one POKéMON\nin battle at a time."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4826 {
    "Would you like to battle?"
}

text Naranja_7islasPomelo_G03_M02_Text_081A4840 {
    "Which Battle Mode would you like\nto play?"
}

text Naranja_7islasPomelo_G03_M02_Text_081A486A {
    "For a DOUBLE BATTLE, you must have\nat least two POKéMON."
}

text Naranja_7islasPomelo_G03_M02_Text_081A48A3 {
    "For trading, you must have at least\ntwo POKéMON with you."
}

text Naranja_7islasPomelo_G03_M02_Text_081A48DD {
    "Your {STR_VAR_1} BERRY-holding POKéMON\ncan’t be traded."
}

text Naranja_7islasPomelo_G03_M02_Text_081A490C {
    "Please wait.\n... ... B Button: Cancel"
}

text Naranja_7islasPomelo_G03_M02_Text_081A4A22 {
    "Please enter."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4A30 {
    "Someone is not ready to link.\pPlease come back after everyone has\nmade preparations."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4A85 {
    "Sorry, we have a transmission error...\nPlease reset and try again."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4AC8 {
    "Sorry, we have a transmission error.\nYou may not mix records in different\llanguages."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4B1D {
    "The link partners appear to have made\ndifferent selections."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4B59 {
    "Please come again."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4B6C {
    "The number of participants is\nincorrect."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4B95 {
    "The SINGLE Battle Mode cannot be\nplayed by {STR_VAR_1} players."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4BCC {
    "The DOUBLE Battle Mode cannot be\nplayed by {STR_VAR_1} players."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4C03 {
    "There must be four players to play\nthis Battle Mode."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4C38 {
    "Please confirm the number of players\nand start again."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4E50 {
    "The TRAINER CARD data will\nbe rewritten."
}

text Naranja_7islasPomelo_G03_M02_Text_081A4E79 {
    "I hope to see you again!"
}
