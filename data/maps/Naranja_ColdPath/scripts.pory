script Naranja_ColdPath_EventScript_TotodileDoll {
    lock
    waitse
    playmoncry(SPECIES_MAWILE, 0x2800)
    waitse
    nop
    delay(0x30)
    msgbox(Naranja_ColdPath_Text_086B6989, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_COLD_PATH_TOTODILE_DOLL, Naranja_ColdPath_Movement_086B67C1)
    applymovement(LOCALID_NARANJA_COLD_PATH_BARD, Naranja_ColdPath_Movement_086B67D1)
    delay(0xB0)
    setflag(FLAG_NARANJA_GOLDUCK_HELPING_ON_CAMINO_FRIO)
    release
    end
}

script Naranja_ColdPath_EventScript_Trigger_2 {
    checkflag(FLAG_HIDE_NARANJA_COLD_PATH_G00_M29_SWIMMER_F)
    goto_if(EQUAL, Naranja_ColdPath_EventScript_Sub_086B7E7E)
    getpartysize
    compare_var_to_value(VAR_RESULT, 6)
    goto_if(LESS_THAN, Naranja_ColdPath_EventScript_Sub_086B6630)
    applymovement(LOCALID_NARANJA_COLD_PATH_BARD, Naranja_ColdPath_Movement_08229547)
    msgbox(Naranja_ColdPath_Text_086B67E0, MSGBOX_AUTOCLOSE)
    nop
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_086B5425)
    delay(0x10)
    end
}

script Naranja_ColdPath_EventScript_Bard {
    checkflag(FLAG_HIDE_NARANJA_COLD_PATH_G00_M29_NURSE)
    call_if(LESS_THAN, Naranja_ColdPath_EventScript_Sub_086B6B23)
    msgbox(Naranja_ColdPath_Text_086B6BB0, MSGBOX_DEFAULT)
    faceplayer
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_0802DE50)
    msgbox(Naranja_ColdPath_Text_086B6BB5, MSGBOX_AUTOCLOSE)
    release
    end
}

script Naranja_ColdPath_EventScript_Sub_086B6B23 {
    lock
    faceplayer
    msgbox(Naranja_ColdPath_Text_086B6BCB, MSGBOX_DEFAULT)
    applymovement(LOCALID_NARANJA_COLD_PATH_BARD, Naranja_ColdPath_Movement_080008A0)
    msgbox(Naranja_ColdPath_Text_086B6BDA, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_COLD_PATH_BARD, Naranja_PinkanIsland_Movement_0800A854)
    msgbox(Naranja_ColdPath_Text_086B6C1A, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_COLD_PATH_BARD, Naranja_ColdPath_Movement_086B67C1)
    delay(0x30)
    removeobject(LOCALID_NARANJA_COLD_PATH_BARD)
    delay(0x10)
    setobjectxy(LOCALID_NARANJA_COLD_PATH_SWIMMER_F, 0x11, 0x28)
    delay(2)
    applymovement(LOCALID_NARANJA_COLD_PATH_SWIMMER_F, Naranja_ColdPath_Movement_086B6B9A)
    delay(0x60)
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_08003246)
    delay(0xA0)
    applymovement(LOCALID_PLAYER, Naranja_PinkanIsland_Movement_0800A854)
    delay(0x40)
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_080008A0)
    clearflag(FLAG_HIDE_NARANJA_COLD_PATH_G00_M29_NURSE)
    removeobject(LOCALID_NARANJA_COLD_PATH_SWIMMER_F)
    delay(0x10)
    release
    end
}

script Naranja_ColdPath_EventScript_Sub_086B6D80 {
    faceplayer
    msgbox(Naranja_ColdPath_Text_086B6F0D, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_NARANJA_COLD_PATH_NURSE, Naranja_ColdPath_Movement_086B67C2)
    delay(5)
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_080008A0)
    delay(0x20)
    removeitem(ITEM_POTION, 1)
    msgbox(Naranja_ColdPath_Text_086B6FBA, MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, Naranja_ColdPath_Movement_086B67C2)
    delay(0x60)
    clearflag(FLAG_NARANJA_GOLDUCK_HELPING_ON_CAMINO_FRIO)
    warp(MAP_NARANJA_UNDERWATER3, 0, 0, 0)
    end
}

script Naranja_ColdPath_EventScript_Nurse {
    faceplayer
    msgbox(Naranja_ColdPath_Text_086B6DC0, MSGBOX_YESNO)
    compare_var_to_value(VAR_RESULT, 0)
    goto_if(EQUAL, Naranja_ColdPath_EventScript_Sub_086B7E7E)
    nop
    nop
    nop
    checkitem(ITEM_POTION, 0)
    compare_var_to_value(VAR_RESULT, 1)
    call_if(EQUAL, Naranja_ColdPath_EventScript_Sub_086B6D80)
    msgbox(Naranja_ColdPath_Text_086B6EC9, MSGBOX_AUTOCLOSE)
    end
}

