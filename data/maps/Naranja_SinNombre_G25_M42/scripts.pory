text Naranja_SinNombre_G25_M42_Text_081993C1 {
    "Arrrgh! I’m fed up and dog-tired of\ncleaning this huge place!\pLet’s have a quick battle!"
}

text Naranja_SinNombre_G25_M42_Text_0819941A {
