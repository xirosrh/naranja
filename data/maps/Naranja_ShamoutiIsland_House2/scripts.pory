text Naranja_ShamoutiIsland_House2_Text_08186306 {
    "People... POKéMON...\pTheir hidden powers are aroused by\nliving in natural environments..."
}

text Naranja_ShamoutiIsland_House2_Text_08186360 {
    "Let this old woman see if your hidden\npower has awoken...\pI hold a coin in my hand.\pNow, tell me, have I palmed it in the\nright hand? Or in the left?"
}

text Naranja_ShamoutiIsland_House2_Text_081863F6 {
    "Oh! Yes, correct!\pWe shall try again.\pIn which hand have I palmed the coin?\nThe right or left?"
}

text Naranja_ShamoutiIsland_House2_Text_08186455 {
    "Oh! Yes, correct again!\pWe shall try once more.\pIn which hand have I palmed the coin?\nThe right or left? Choose!"
}

text Naranja_ShamoutiIsland_House2_Text_081864C6 {
    "Oh! Splendid!\nYour hidden power has awoken!\pHere, take this and awaken the hidden\npower of your POKéMON."
}

text Naranja_ShamoutiIsland_House2_Text_0818652F {
    "HIDDEN POWER is a move that changes\nwith the POKéMON."
}

text Naranja_ShamoutiIsland_House2_Text_08186565 {
    "No, too bad.\nYou guessed wrong."
}
