Naranja_Route133_G00_M48_Text_081C2DA5::
# 56 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "Did the currents carry you here, too?\nThis must have been fated. Let’s battle!$"

Naranja_Route133_G00_M48_Text_081C2DF4::
# 60 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "Strong!\nToo much so!$"

Naranja_Route133_G00_M48_Text_081C2E09::
# 64 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "It’s just my luck that a tough TRAINER\nlike you would drift here...\lI must be cursed...$"

Naranja_Route133_G00_M48_Text_081C2E61::
# 68 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "I’ve led a life of woe and misery...\nI’ve been cast away, and this is where\lI’ve drifted...$"

Naranja_Route133_G00_M48_Text_081C2EBD::
# 72 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "Another loss...$"

Naranja_Route133_G00_M48_Text_081C2ECD::
# 76 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "A life adrift...\nI don’t want it anymore!$"

Naranja_Route133_G00_M48_Text_081C2EF7::
# 80 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "Welcome!\nI’ve been expecting you!$"

Naranja_Route133_G00_M48_Text_081C2F19::
# 84 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "No! Please!$"

Naranja_Route133_G00_M48_Text_081C2F25::
# 88 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "A strong child TRAINER...\nThat’s so annoying!$"

Naranja_Route133_G00_M48_Text_081C2F53::
# 92 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "I want to win like everyone else, but I\nwon’t raise POKéMON like everyone else.$"

Naranja_Route133_G00_M48_Text_081C2FA3::
# 96 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "Darn it!\nMy way is still too slack!$"

Naranja_Route133_G00_M48_Text_081C2FC7::
# 100 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "It’s way more fun to do things the way\nI want than to be like everybody else.\lI mean, that’s obvious!$"

Naranja_Route133_G00_M48_Text_081C302D::
# 104 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "I came all the way out here with my\nBIRD POKéMON.$"

Naranja_Route133_G00_M48_Text_081C305F::
# 108 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "You...\nYou’re stunningly cool!$"

Naranja_Route133_G00_M48_Text_081C307E::
# 112 "data/maps/Naranja_Route133_G00_M48/scripts.pory"
	.string "I’d like to go back to FORTREE, but I’ve\ngrown to like this place, too.$"
