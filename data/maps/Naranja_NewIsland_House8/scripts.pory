text Naranja_NewIsland_House8_Text_081900F7 {
    "Do you know the POKéMON SHROOMISH?\nIt’s hardly ever seen in SOOTOPOLIS.\pAnyway, I love big SHROOMISH.\nThe bigger the better.\pBut my younger brother, he says that\nBARBOACH is bigger.\pThat’s silly. SHROOMISH has to be\nbigger than that!\pHuh? Do you have a SHROOMISH with you?\nP-p-please, show me!"
}

text Naranja_NewIsland_House8_Text_0819021D {
    "{STR_VAR_2} inches!\nOh, my gosh, this is a big one!\pIt might even beat the big BARBOACH\nmy younger brother saw!\pThanks for showing me.\nThis is my thanks!"
}

text Naranja_NewIsland_House8_Text_081902C4 {
    "Hunh?\nYour BAG is crammed full."
}

text Naranja_NewIsland_House8_Text_081902E4 {
    "{STR_VAR_2} inches, is it?\pHmm... I’ve seen a bigger SHROOMISH\nthan this one."
}

text Naranja_NewIsland_House8_Text_08190329 {
    "Oh, now this is quite something...\nBut it’s not a SHROOMISH!"
}

text Naranja_NewIsland_House8_Text_08190366 {
    "You don’t have a big SHROOMISH?\nThat’s too bad...\pIf you get a big SHROOMISH, please\ncome show me."
}

text Naranja_NewIsland_House8_Text_081903C9 {
    "The biggest SHROOMISH in history!\n{STR_VAR_2}’s {STR_VAR_3}-inch giant!\pA SHROOMISH bigger than a BARBOACH\nalways wanted!"
}

text Naranja_NewIsland_House8_Text_08190431 {
    "Do you know the POKéMON BARBOACH?\nIt’s rarely seen in SOOTOPOLIS.\pI love, I mean love, big BARBOACH!\pMy big brother says that SHROOMISH is\nbigger.\pBut that’s wrong! Everyone knows that\nBARBOACH is a lot bigger.\pHunh? Do you have a BARBOACH?\nP-p-please show me!"
}

text Naranja_NewIsland_House8_Text_08190536 {
    "{STR_VAR_2} inches!\nWow, that is big!\pIt might be even bigger than the huge\nSHROOMISH my big brother saw.\pThanks for showing me!\nThis is my thanks!"
}

text Naranja_NewIsland_House8_Text_081905C1 {
    "Whoops, looks like your BAG is full."
}

text Naranja_NewIsland_House8_Text_081905E6 {
    "{STR_VAR_2} inches?\pHmm... I’ve seen a bigger BARBOACH\nthan this one here."
}

text Naranja_NewIsland_House8_Text_08190628 {
    "Well, isn’t this something!\nBut it’s no BARBOACH!"
}

text Naranja_NewIsland_House8_Text_0819065A {
    "Don’t you have a big BARBOACH?\nHow disappointing...\pIf you get a big BARBOACH, please\ncome show me!"
}

text Naranja_NewIsland_House8_Text_081906BE {
    "The biggest BARBOACH in history!\n{STR_VAR_2}’s {STR_VAR_3}-inch colossus!\pA BARBOACH bigger than a SHROOMISH\nalways wanted!"
}
