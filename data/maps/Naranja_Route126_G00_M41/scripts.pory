text Naranja_Route126_G00_M41_Text_081C1590 {
    "Swimming is a full-body workout!\nYou will get fit!"
}

text Naranja_Route126_G00_M41_Text_081C15C3 {
    "I admit it! You win!"
}

text Naranja_Route126_G00_M41_Text_081C15D8 {
    "Thanks to my daily swimming routine...\nLook! Feast your eyes on this physique!"
}

text Naranja_Route126_G00_M41_Text_081C1627 {
    "This towering white mountain of rock\nis SOOTOPOLIS CITY."
}

text Naranja_Route126_G00_M41_Text_081C1660 {
    "I was done in?"
}

text Naranja_Route126_G00_M41_Text_081C166F {
    "I can’t find the entrance to\nSOOTOPOLIS. Where could it be?"
}

text Naranja_Route126_G00_M41_Text_081C16AB {
    "Ufufufufu!\nI’m a mermaid!"
}

text Naranja_Route126_G00_M41_Text_081C16C5 {
    "My fantasy burst as if it were a bubble!\nBlub, blub, blub..."
}

text Naranja_Route126_G00_M41_Text_081C1702 {
    "You thrashed me... I want to\ndisappear in a wave of despair..."
}

text Naranja_Route126_G00_M41_Text_081C1741 {
    "Hello, kiddo!\nWant a battle with me?"
}

text Naranja_Route126_G00_M41_Text_081C1766 {
    "Oh, noooooh!"
}

text Naranja_Route126_G00_M41_Text_081C1773 {
    "I love frolicking with POKéMON in\nthe sea like this!"
}
