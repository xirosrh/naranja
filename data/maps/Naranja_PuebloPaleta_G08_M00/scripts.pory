text Naranja_PuebloPaleta_G08_M00_Text_08179CA1 {
    "Oh, hello, {PLAYER}! We’ve got\nsomething we want you to have.\pMy husband has it, so please have a\nword with him, dear."
}

text Naranja_PuebloPaleta_G08_M00_Text_08179D12 {
    "I want you to keep this a secret\nfrom my husband...\pBut our WALLY left VERDANTURF TOWN\nwithout telling anyone.\pYou know, WALLY is frail, but\nhe’s surprisingly strong-willed.\pI’m sure that he’ll come back safe\nand sound one day!"
}

text Naranja_PuebloPaleta_G08_M00_Text_086BF11B {
    "Delia: ¡Esta vez no tengo nada para tí!\n¿Crees que cada vez que vengas te\lvas a llevar algo?\p\pDe todos modos…\n¡Suerte!"
}

text Naranja_PuebloPaleta_G08_M00_Text_086BFAF4 {
    "¡{PLAYER} encontró MOCHILA!\pDelia: ¡Eh! ¿Que haces?\n¡Esto es mío!"
}
