text Naranja_BandonedShip_G24_M62_Text_081987C1 {
    "HAL: While searching for treasures,\nwe discovered a TRAINER!"
}

text Naranja_BandonedShip_G24_M62_Text_081987FE {
    "HAL: We couldn’t win even though\nwe worked together..."
}

text Naranja_BandonedShip_G24_M62_Text_08198835 {
    "HAL: We can’t find any treasures...\nI wonder if someone got them already?"
}

text Naranja_BandonedShip_G24_M62_Text_0819887F {
    "HAL: You don’t even have two POKéMON.\nYou can’t expect to beat us like that."
}

text Naranja_BandonedShip_G24_M62_Text_081988CC {
    "LOIS: Oh? We were looking for some\ntreasure, but we only found a TRAINER."
}

text Naranja_BandonedShip_G24_M62_Text_08198916 {
    "LOIS: Oh, wow, you’re strong!"
}

text Naranja_BandonedShip_G24_M62_Text_08198934 {
    "LOIS: I wonder where the treasures\nare hidden?\pI already know what I’m going to buy\nwhen I find them!"
}

text Naranja_BandonedShip_G24_M62_Text_0819899A {
    "LOIS: Don’t you have two POKéMON?\nWe’ll have to battle another time!"
}

text Naranja_BandonedShip_G24_M62_Text_081989DF {
    "HAL: We’ve been searching for\ntreasures all this time.\pOur POKéMON have grown stronger, too.\nLet us show you, okay?"
}

text Naranja_BandonedShip_G24_M62_Text_08198A53 {
    "HAL: You’re strong as usual!"
}

text Naranja_BandonedShip_G24_M62_Text_08198A70 {
    "HAL: We can’t find any treasures,\nwe lose at POKéMON...\pI want to go home... But if I say that,\nshe gets all angry with me..."
}

text Naranja_BandonedShip_G24_M62_Text_08198AEE {
    "HAL: You don’t even have two POKéMON.\nYou can’t expect to beat us like that."
}

text Naranja_BandonedShip_G24_M62_Text_08198B3B {
    "LOIS: Oh, hi, we meet again!\pJust like us, you haven’t given up\nsearching for treasures!\pHow about we battle, and the loser has\nto give up looking?"
}

text Naranja_BandonedShip_G24_M62_Text_08198BCF {
    "LOIS: Oh, we lost again..."
}

text Naranja_BandonedShip_G24_M62_Text_08198BEA {
    "LOIS: We’ll raise our POKéMON more.\pWe’re not going home until we find our\ntreasures!"
}

text Naranja_BandonedShip_G24_M62_Text_08198C40 {
    "LOIS: Don’t you have two POKéMON?\nWe’ll have to battle another time!"
}
