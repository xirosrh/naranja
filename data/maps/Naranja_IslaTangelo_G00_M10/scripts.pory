text Naranja_IslaTangelo_G00_M10_Text_0816AFE1 {
    "Lo que compras en los {COLOR 0x03}PokePuestos  \n{COLOR 0x01}se guarda en tu ぁぃぅ.\p¡ Así podrás usarlo cuando quieras !"
}

text Naranja_IslaTangelo_G00_M10_Text_0816B045 {
    "¡Oiga! ¡Espere!\p       \pEsto no es el metro, y no,\nno le voy a dejar colarse.\pPara viajar en zepelin necesitará el \nbillete.          "
}

text Naranja_IslaTangelo_G00_M10_Text_0816B0CC {
    "I just discovered the footprints of\na rare POKéMON!\pWait until I finish sketching\nthem, okay?"
}

text Naranja_IslaTangelo_G00_M10_Text_0816B12A {
    "¿Viste todos esos geodudes?\pSon de un montañista que los cría para\nque le ayuden en los {COLOR 0x0E}Picos Naranjas"
}

text Naranja_IslaTangelo_G00_M10_Text_0816B196 {
    "Misty: ¡Ven!\n¡Vamos {PLAYER}, por aquí!\p¡¡-!!"
}

text Naranja_IslaTangelo_G00_M10_Text_0816B1BE {
    "Ash: ¡{PLAYER}!\n¿Sabías que hay un centro\lde recuperación pokemon?\p ¡No me lo pierdo!"
}

text Naranja_IslaTangelo_G00_M10_Text_0816D51A {
    "{COLOR 0x04}¿Qué pinta aquí un geodude?\p{COLOR 0x09}¡Diuuuudd!"
}

text Naranja_IslaTangelo_G00_M10_Text_086B3490 {
    "¡Hola!\p¿Eres turista verdad?\p{COLOR 0x04}{PLAYER}: Ehh…\p{COLOR 0x01}¿Conoces las ventajas de los\n{COLOR 0x03}PokePuestos{COLOR 0x01}?\p¡Ven Conmigo!"
}

text Naranja_IslaTangelo_G00_M10_Text_086BEF1C {
    "{COLOR 0x0D}Isla TANGELO\n{COLOR 0x09}“Vivela“"
}

text Naranja_IslaTangelo_G00_M10_Text_086BF54C {
    "Este es un puesto típico de las islas.\p¿Lo sabías?\p{COLOR 0x04}{PLAYER}: Suponia que…\p{COLOR 0x01}Aquí podrás comprar objetos para \ntus pokemon, de todo…y barato.\pPor tu interés, te regalamos esta POCIÓN.\n"
}
