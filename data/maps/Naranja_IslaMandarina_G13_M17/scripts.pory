text Naranja_IslaMandarina_G13_M17_Text_0818BFB5 {
    "Welcome to LILYCOVE DEPARTMENT STORE."
}

text Naranja_IslaMandarina_G13_M17_Text_0818BFDB {
    "Whenever I come to the DEPARTMENT\nSTORE, I always end up buying all sorts\lof things because it’s so fun."
}

text Naranja_IslaMandarina_G13_M17_Text_0818C044 {
    "Today, my mom is going to buy me some\nnice furniture."
}

text Naranja_IslaMandarina_G13_M17_Text_0818C07A {
    "I’m buying something for my AZUMARILL\nas a reward for winning a CONTEST."
}

text Naranja_IslaMandarina_G13_M17_Text_0818C0C3 {
    "AZUMARILL: Maririroo!"
}

text Naranja_IslaMandarina_G13_M17_Text_0818C0D9 {
    "1F: SERVICE COUNTER\n    LOTTERY CORNER\p2F: TRAINER’S ZONE\p3F: BATTLE COLLECTION\p4F: TM CORNER\p5F: POKé DOLL FLOOR\pROOFTOP: ROOFTOP PLAZA"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4B5E {
    "This is the POKéMON LOTTERY CORNER.\pAll shoppers visiting our DEPARTMENT\nSTORE get to draw a POKéMON LOTO\lTICKET.\pIf the LOTO TICKET’s number matches\nthe ID number of any of your POKéMON,\lyou will receive a fabulous gift.\pWould you like to draw a POKéMON\nLOTO TICKET?"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4C6A {
    "Please come back tomorrow."
}

text Naranja_IslaMandarina_G13_M17_Text_081C4C85 {
    "Please do visit us again."
}

text Naranja_IslaMandarina_G13_M17_Text_081C4CC6 {
    "Please pick a LOTO TICKET.\n...{PAUSE 0x39} ...{PAUSE 0x39} ...{PAUSE 0x39}"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4CF6 {
    "The LOTO TICKET number is {STR_VAR_1}.\pI need to run a check on this number\nto see if it matches any of your\lPOKéMON’s ID numbers. Please wait."
}

text Naranja_IslaMandarina_G13_M17_Text_081C4D7D {
    "Congratulations!\pThe ID number of your team’s\n{STR_VAR_1} matches your LOTO TICKET’s\lnumber!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4DD1 {
    "Congratulations!\pThe ID number of your PC-boxed\n{STR_VAR_1} matches your LOTO TICKET’s\lnumber!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4E27 {
    "I’m sorry.\nNone of the numbers matched."
}

text Naranja_IslaMandarina_G13_M17_Text_081C4E4F {
    "Two digits matched, so you win the\nthird prize!\lYou’ve won the {STR_VAR_1}!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4E92 {
    "Three digits matched, so you win the\nsecond prize!\lYou’ve won the {STR_VAR_1}!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4ED8 {
    "Four digits matched, so you win the\nfirst prize!\lYou’ve won the {STR_VAR_1}!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4F1C {
    "Oh, my goodness, all five digits matched!\pYou’ve won the jackpot prize!\nYou’ve won the {STR_VAR_1}!"
}

text Naranja_IslaMandarina_G13_M17_Text_081C4F77 {
    "Oh?\nYou seem to have no room for this.\pPlease make room in your BAG and\nlet me know."
}

text Naranja_IslaMandarina_G13_M17_Text_081C4FCC {
    "{PLAYER}?\nYes, I’ve been expecting you.\pThis is the prize we’ve been holding\nfor you."
}

text Naranja_IslaMandarina_G13_M17_Text_081C501C {
    "Please do visit again."
}
