text Naranja_Route110_G29_M07_Text_0819D423 {
    "CLICKETY-CLACK...\nMECHADOLL 1 AM I!\pIF YOU ANSWER QUIZZES CORRECTLY,\nTHEN YOU WILL GO TO MECHADOLL 5.\lTHEN YOU CAN OBTAIN THE SECRET CODE."
}

text Naranja_Route110_G29_M07_Text_0819D4AE {
    "MECHADOLL 1 QUIZ.\pOne of these POKéMON is not found\non ROUTE 103. Which one is it?"
}

text Naranja_Route110_G29_M07_Text_0819D501 {
    "MECHADOLL 1 QUIZ.\pOne of these POKéMON is not of the\nGRASS type. Which one is it?"
}

text Naranja_Route110_G29_M07_Text_0819D553 {
    "MECHADOLL 1 QUIZ.\pOne of these POKéMON uses SCRATCH.\nWhich one is it?"
}

text Naranja_Route110_G29_M07_Text_0819D599 {
    "CONGRATULATIONS. CORRECT YOU ARE.\nGO THROUGH. PLEASE."
}

text Naranja_Route110_G29_M07_Text_0819D5CF {
    "BZZZT. DISAPPOINTMENT.\nERROR."
}

text Naranja_Route110_G29_M07_Text_0819D5ED {
    "WAHAHAHAHA! WAHAHAHAHA!\nCLICKETY-CLACK!"
}

text Naranja_Route110_G29_M07_Text_0819D615 {
    "YOUR NEXT CHALLENGE WE WAIT FOR."
}

text Naranja_Route110_G29_M07_Text_0819D636 {
    "CLICKETY-CLACK...\nMECHADOLL 2 AM I!\pMECHADOLL 1’S QUIZ DIFFICULTY LEVEL\nIS SET TOO LOW."
}

text Naranja_Route110_G29_M07_Text_0819D68E {
    "MECHADOLL 2 QUIZ.\pIn PROF. BIRCH’s bag, there were three\nPOKéMON. Which one was at the right?"
}

text Naranja_Route110_G29_M07_Text_0819D6EC {
    "MECHADOLL 2 QUIZ.\pWhich POKéMON was offered for a trade\nat the POKéMON TRAINER’S SCHOOL?"
}

text Naranja_Route110_G29_M07_Text_0819D745 {
    "MECHADOLL 2 QUIZ.\pThe DEVON RESEARCHER was looking for\nwhat POKéMON in PETALBURG WOODS?"
}

text Naranja_Route110_G29_M07_Text_0819D7D3 {
    "CLICKETY-CLACK...\nMECHADOLL 3 AM I!\pMATTERS OF MONEY ARE MY SOLE FOCUS."
}

text Naranja_Route110_G29_M07_Text_0819D81B {
    "MECHADOLL 3 QUIZ.\pWhich costs more?\nThree POKé BALLS or one SUPER POTION?"
}

text Naranja_Route110_G29_M07_Text_0819D865 {
    "MECHADOLL 3 QUIZ.\pSell one ESCAPE ROPE and buy\none ANTIDOTE. How much money remains?"
}

text Naranja_Route110_G29_M07_Text_0819D8BA {
    "MECHADOLL 3 QUIZ.\pDo one FULL HEAL and GREAT BALL\ncost more than one REVIVE?"
}

text Naranja_Route110_G29_M07_Text_0819D93D {
    "CLICKETY-CLACK...\nMECHADOLL 4 THAT IS ME!\pMY QUIZ IS AN OBJECT OF BEAUTY."
}

text Naranja_Route110_G29_M07_Text_0819D987 {
    "MECHADOLL 4 QUIZ.\pRUSTBORO GYM LEADER ROXANNE used a\nGEODUDE. Was it male or female?"
}

text Naranja_Route110_G29_M07_Text_0819D9DC {
    "MECHADOLL 4 QUIZ.\pIn DEWFORD HALL, were there more men\nor women?"
}

text Naranja_Route110_G29_M07_Text_0819DA1D {
    "MECHADOLL 4 QUIZ.\pThe first TRAINER in DEWFORD GYM was\nmale or female?"
}

text Naranja_Route110_G29_M07_Text_0819DA9A {
    "CLICKETY-CLACK...\nMECHADOLL 5 AM I!\pTHE MASTER’S BEST AND PROUDEST\nACHIEVEMENT AM I."
}

text Naranja_Route110_G29_M07_Text_0819DAEF {
    "MECHADOLL 5 QUIZ.\pHow many BIKES does RYDEL have on\ndisplay outside his cycle shop?"
}

text Naranja_Route110_G29_M07_Text_0819DB43 {
    "MECHADOLL 5 QUIZ.\pHow many people give you BERRIES at the\nPRETTY PETAL flower shop?"
}

text Naranja_Route110_G29_M07_Text_0819DB97 {
    "MECHADOLL 5 QUIZ.\pHow many signs are there in\nLILYCOVE CITY?"
}
