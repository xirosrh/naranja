text Naranja_Route110_G29_M08_Text_0819DC87 {
    "When I heard there was a strange\nhouse, I had to check it out."
}

text Naranja_Route110_G29_M08_Text_0819DCC6 {
    "I’ve discovered a tough TRAINER!"
}

text Naranja_Route110_G29_M08_Text_0819DCE7 {
    "I’m sure having a good time checking\nthis place out.\pIt’s a challenge I’ve found worth\nrepeating!"
}

text Naranja_Route110_G29_M08_Text_0819DD49 {
    "Maybe I could get my BIRD POKéMON\nto fly over the wall..."
}

text Naranja_Route110_G29_M08_Text_0819DD83 {
    "Gwaaah! I blew it!"
}

text Naranja_Route110_G29_M08_Text_0819DD96 {
    "Ehehehe... I guess I lost because I\nwas trying to cheat."
}

text Naranja_Route110_G29_M08_Text_0819DDCF {
    "I’m getting dizzy from these rotating\ndoors..."
}

text Naranja_Route110_G29_M08_Text_0819DDFE {
    "Everything’s spinning around and\naround. I can’t take this anymore..."
}

text Naranja_Route110_G29_M08_Text_0819DE44 {
    "You don’t seem to be affected at all.\nOr do you have your poker face on?"
}
